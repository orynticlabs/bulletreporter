NEXT_PUBLIC_SITE_URL=https://bulletreporter.com
CORS_ALLOWED_ORIGINS=https://bulletreporter.com,http://localhost:3002,https://bulletreporter.vercel.app,https://bulletreporter.onrender.com,https://bulletreporter-git-dev-orynticlabsofficial.vercel.app
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@bulletreporter
NEXT_PUBLIC_FACEBOOK_PAGE_URL=
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/bulletreporter
NEXT_PUBLIC_OPENWEATHER_API_KEY=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_PHONE_LABEL=
NEXT_PUBLIC_CONTACT_LOCATION=
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_DEVELOPER_NAME=
NEXT_PUBLIC_DEVELOPER_URL=

# YouTube Shorts
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_SHORTS_PLAYLIST_ID=
YOUTUBE_SHORTS_LIMIT=24

# Payload CMS
PAYLOAD_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@ep-your-neon-endpoint-pooler.region.aws.neon.tech/dbname?sslmode=verify-full
# Used only by Prisma migration scripts. The hostname must not contain "-pooler".
DIRECT_DATABASE_URL=postgresql://user:password@ep-your-neon-endpoint.region.aws.neon.tech/dbname?sslmode=verify-full
POSTGRES_URL=
POSTGRES_PRISMA_URL=
# Keep Payload and all normal application traffic on the pooled endpoint.
PAYLOAD_DATABASE_URL=postgresql://user:password@ep-your-neon-endpoint-pooler.region.aws.neon.tech/dbname?sslmode=verify-full
# Keep false. Prisma migrations create/update the database schema.
PAYLOAD_DB_PUSH=false
CRON_SECRET=replace-with-a-long-random-cron-secret
NEWSLETTER_BATCH_SIZE=500
NEWSLETTER_SEND_CONCURRENCY=5
NEWSLETTER_DB_POOL_SIZE=5

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Payload media storage on Cloudinary
PAYLOAD_REQUIRE_CLOUDINARY=true
PAYLOAD_MAX_UPLOAD_MB=3
PAYLOAD_MAX_VIDEO_UPLOAD_MB=100
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=
CLOUDINARY_VIDEO_FOLDER=bullet_reporter/videos

# Email / Nodemailer SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@bulletreporter.com
