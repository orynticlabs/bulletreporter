NEXT_PUBLIC_SITE_URL=https://bulletreporter.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=
NEXT_PUBLIC_FACEBOOK_PAGE_URL=
NEXT_PUBLIC_OPENWEATHER_API_KEY=

# YouTube Shorts
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
YOUTUBE_SHORTS_PLAYLIST_ID=
YOUTUBE_SHORTS_LIMIT=24

# Payload CMS
PAYLOAD_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@ep-your-neon-endpoint-pooler.region.aws.neon.tech/dbname?sslmode=verify-full
PAYLOAD_DB_PUSH=false
CRON_SECRET=replace-with-a-long-random-cron-secret

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# Payload media storage on Cloudinary
PAYLOAD_REQUIRE_CLOUDINARY=true
PAYLOAD_MAX_UPLOAD_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=bullet_reporter

# Email / Nodemailer SMTP configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Bullet Reporter <your-email@gmail.com>"
